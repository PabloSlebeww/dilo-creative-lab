---
import "../styles/site.css";
import "../styles/overrides.css";
import { diloWordmarkPath } from "../content/dilo-wordmark";
import {
  getCrtMarkup,
  getPageData,
  getPageMarkup,
  getTransitionMarkup,
  navForPath,
  type PageKey,
} from "../lib/content";

interface Props {
  page: PageKey;
}

const { page } = Astro.props;
const data = getPageData(page);
const pageMarkup = getPageMarkup(page);
const nav = navForPath(Astro.url.pathname);
const transition = getTransitionMarkup();
const crt = getCrtMarkup();
const canonical = new URL(data.path, Astro.site ?? Astro.url.origin).toString();
const ogImage = new URL(data.og_image || "/assets/dilo-og.png", Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en" class="no-js" data-palette="black">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var query = params.get("palette");
          var stored = window.localStorage.getItem("dilo-palette");
          var palette = query === "lime" || query === "black" ? query : stored === "lime" ? "lime" : "black";
          document.documentElement.setAttribute("data-palette", palette);
        } catch (_error) {
          document.documentElement.setAttribute("data-palette", "black");
        }
      })();
    </script>
    <title>{data.title}</title>
    <meta name="description" content={data.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="DILO Creative Lab" />
    <meta property="og:title" content={data.og_title || data.title} />
    <meta property="og:description" content={data.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href="/assets/dilo-badge-32.png" />
    <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href="/assets/dilo-badge-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/dilo-badge-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/dilo-badge-180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/dilo-badge-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/dilo-badge-512.png" />
    <link
      rel="preload"
      href="/fonts/6a147ac5a43bd28b4affe657_FKRasterRomanCompact-Smooth.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/698f75ebca548c8f48111c32_KHTekaTRIAL-Regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body data-barba="wrapper" data-crt="true" class="body">
    <svg class="dilo-symbol-sprite" aria-hidden="true" focusable="false">
      <symbol id="dilo-wordmark" viewBox="0 0 544 194">
        <path d={diloWordmarkPath} fill="currentColor"></path>
      </symbol>
    </svg>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Fragment set:html={nav} />
    <Fragment set:html={transition} />
    <div id="page-status" class="sr-only" role="status" aria-live="polite"></div>
    <div
      id="main-content"
      role="main"
      data-barba="container"
      data-sticker="wrap"
      data-page={page}
      class={data.container_class}
      tabindex="-1"
      set:html={pageMarkup}
    >
    </div>
    <Fragment set:html={crt} />

    <div class="palette-switcher" data-palette-switcher role="group" aria-label="Preview palette">
      <span class="palette-switcher__label" aria-hidden="true">Palette</span>
      <button class="palette-switcher__button" type="button" data-palette-option="black" aria-pressed="true">
        A · Black
      </button>
      <button class="palette-switcher__button" type="button" data-palette-option="lime" aria-pressed="false">
        B · Lime
      </button>
    </div>

    <!-- Exact published interaction stack, self-hosted. -->
    <script is:inline src="/vendor/barba.umd.min.js"></script>
    <script is:inline src="/vendor/lenis.min.js"></script>
    <script is:inline src="/vendor/gsap.min.js"></script>
    <script is:inline src="/vendor/CustomEase.min.js"></script>
    <script is:inline src="/vendor/ScrambleTextPlugin.min.js"></script>
    <script is:inline src="/vendor/Draggable.min.js"></script>
    <script is:inline src="/vendor/Observer.min.js"></script>
    <script is:inline src="/vendor/InertiaPlugin.min.js"></script>
    <script is:inline src="/vendor/SplitText.min.js"></script>
    <script is:inline src="/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/scripts/site.js"></script>
    <script is:inline src="/vendor/slater.js"></script>
  </body>
</html>
